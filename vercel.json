{
  "version": 2,
  "installCommand": "npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "routes": [
    { "src": "/sitemap", "dest": "/index.html" },
    { "src": "/privacy", "dest": "/index.html" },
    { "src": "/terms", "dest": "/index.html" },
    { "src": "/security", "dest": "/index.html" },
    { "src": "/properties/(.*)", "dest": "/index.html" },
    { "src": "/agencies/(.*)", "dest": "/index.html" },
    { "src": "/dashboard/(.*)", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

