# ─── Server Config ────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — get from cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/realestate_db?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_realestate_marketplace_2026
JWT_EXPIRE=30d

# ─── CORS — Your Vercel frontend URL ─────────────────────────────────────────
# Must match exactly (no trailing slash)
# Example: https://realestate-xyz.vercel.app
CLIENT_URL=https://YOUR_VERCEL_APP.vercel.app

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# ─── AI / Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# ─── News API ─────────────────────────────────────────────────────────────────
NEWSDATA_API_KEY=YOUR_NEWSDATA_KEY

# ─── Email (Gmail SMTP) — optional ───────────────────────────────────────────
# GMAIL_USER=your_gmail@gmail.com
# GMAIL_PASS=your_gmail_app_password
